{
  "name": "list_podcast_jobs",
  "description": "列出最近的播客生成任务，便于在未提供 job_id 时查找最近任务。",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "返回的任务数量上限。"
      }
    },
    "additionalProperties": false
  }
}
