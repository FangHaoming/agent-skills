{
  "name": "preview_podcast_plan",
  "description": "只生成播客提纲和角色规划，不生成最终音频，适合用户先看讲述结构。",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["file", "url", "text"]
            },
            "path": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "content": {
              "type": "string"
            }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      },
      "config": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "format": {
            "type": "string",
            "enum": ["dialogue", "monologue", "debate", "brief"]
          },
          "audience": {
            "type": "string"
          },
          "tone": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          }
        },
        "required": ["language", "duration_minutes", "format"],
        "additionalProperties": false
      }
    },
    "required": ["sources", "config"],
    "additionalProperties": false
  }
}
